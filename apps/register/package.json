{
  "name": "@adpay/register",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8082",
    "android": "expo start --android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "i18n:extract": "tsx scripts/extract-i18n.ts"
  },
  "dependencies": {
    "@adpay/shared": "workspace:*",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-crypto": "~57.0.3",
    "expo-image-manipulator": "~57.0.0",
    "expo-image-picker": "~57.0.0",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.2.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
