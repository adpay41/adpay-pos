# AD Pay POS — environment template.
# Copy to .env and fill locally. NEVER commit a filled .env. Real values live in
# AWS Secrets Manager (adpay/dev/*) and GitHub Actions secrets.

# --- Core ---
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
API_BASE_URL=

# --- Datastores ---
DATABASE_URL=
REDIS_URL=

# --- Auth ---
JWT_SECRET=
JWT_ISSUER=adpay
DEVICE_TOKEN_TTL_DAYS=
ADMIN_SESSION_SECRET=

# --- Payments (Finix) ---
# Nothing outside packages/api/payments/finix/ reads these.
FINIX_ENV=sandbox
FINIX_API_KEY=
FINIX_API_SECRET=
FINIX_APPLICATION_ID=
FINIX_BASE_URL=
FINIX_WEBHOOK_SECRET=
# stub | finix  — the one value that swaps the payment adapter
PAYMENT_PROVIDER=stub

# --- Sentry ---
SENTRY_DSN_API=
SENTRY_DSN_REGISTER=
SENTRY_DSN_MERCHANT=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_ENVIRONMENT=development

# --- AWS ---
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- OTP / SMS (placeholders) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=adpay-api
