# AD Pay POS — environment template.
# NEVER commit a filled .env. Real values live in AWS Parameter Store (/adpay/dev/*) and
# GitHub Actions secrets.
#
# Local development: `pnpm dev` creates .env from this file and fills the empty local values
# (Docker Postgres/Redis URLs, a freshly generated JWT secret). You do not need to edit anything.

# --- Core ---
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
API_BASE_URL=
# Comma-separated browser origins allowed to call the API (admin, merchant web, register web).
CORS_ORIGINS=

# --- Datastores ---
DATABASE_URL=
REDIS_URL=

# --- Auth ---
JWT_SECRET=
JWT_ISSUER=adpay
DEVICE_TOKEN_TTL_DAYS=
ADMIN_SESSION_SECRET=
# log (dev only: code is shown on screen and in the API log, no SMS) | twilio
OTP_DELIVERY=
# Optional override for the local demo admin password the seed creates.
SEED_ADMIN_PASSWORD=

# --- Payments (Finix) ---
# Nothing outside packages/api/payments/finix/ reads these.
FINIX_ENV=sandbox
FINIX_API_KEY=
FINIX_API_SECRET=
FINIX_APPLICATION_ID=
FINIX_BASE_URL=
FINIX_WEBHOOK_SECRET=
# stub | finix  — the one value that swaps the payment adapter
PAYMENT_PROVIDER=stub

# --- Sentry ---
SENTRY_DSN_API=
SENTRY_DSN_REGISTER=
SENTRY_DSN_MERCHANT=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_ENVIRONMENT=development

# --- AWS ---
AWS_REGION=us-east-2
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- OTP / SMS (placeholders) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=adpay-api
